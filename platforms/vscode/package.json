{
  "name": "pindouverse",
  "displayName": "PindouVerse - Bead Art Editor",
  "description": "PindouVerse (拼豆宇宙) — Open and edit .pindou bead art projects inside VS Code. Pixel art editor for perler/fuse bead designs with 295-color MARD palette, multi-layer support, grid overlay, and blueprint mode.",
  "version": "1.5.0",
  "publisher": "PindouVerse",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/cangelzz/pindouverse.git"
  },
  "homepage": "https://github.com/cangelzz/pindouverse",
  "bugs": {
    "url": "https://github.com/cangelzz/pindouverse/issues"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "icon": "icons/icon.png",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "perler beads",
    "fuse beads",
    "pixel art",
    "bead art",
    "pindou",
    "拼豆"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pindouverse.editor",
        "displayName": "PindouVerse Editor",
        "selector": [
          {
            "filenamePattern": "*.pindou"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pindouverse.newProject",
        "title": "PindouVerse: New Project"
      },
      {
        "command": "pindouverse.openProject",
        "title": "PindouVerse: Open Project"
      },
      {
        "command": "pindouverse.undo",
        "title": "PindouVerse: Undo"
      },
      {
        "command": "pindouverse.redo",
        "title": "PindouVerse: Redo"
      }
    ],
    "keybindings": [
      {
        "command": "pindouverse.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'pindouverse.editor'"
      },
      {
        "command": "pindouverse.redo",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "activeCustomEditorId == 'pindouverse.editor'"
      },
      {
        "command": "pindouverse.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == 'pindouverse.editor'"
      }
    ],
    "languageModelTools": [
      {
        "name": "pindouverse_inspect_blueprint",
        "displayName": "Pindou: inspect blueprint",
        "modelDescription": "Inspect the selected live Pindou blueprint, including unsaved edits. Returns editorId, projectGeneration, revision and activeLayerId for writes. Layer view requires layerId; regions use zero-based x/y and width/height. Omit region for metadata only.",
        "toolReferenceName": "pindou_inspect_blueprint",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "editorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "view": {
              "default": "composite",
              "type": "string",
              "enum": [
                "composite",
                "layer"
              ]
            },
            "layerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "region": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "view"
                ],
                "properties": {
                  "view": {
                    "const": "layer"
                  }
                }
              },
              "then": {
                "required": [
                  "layerId"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "pindouverse_search_palette",
        "displayName": "Pindou: search palette",
        "modelDescription": "Find actual MARD palette codes by code, name or hex value in the selected Pindou editor. Use returned codes for writes; never guess array indices.",
        "toolReferenceName": "pindou_search_palette",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "editorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "query": {
              "default": "",
              "type": "string",
              "maxLength": 100
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "pindouverse_set_beads",
        "displayName": "Pindou: set beads",
        "modelDescription": "Atomically set or clear beads in the named live layer. Zero-based x/y; null means empty, not a transparent bead. Duplicate coordinates are rejected. Use expectedRevision from inspection to protect against intervening hand edits.",
        "toolReferenceName": "pindou_set_beads",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "editorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "projectGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "layerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "beads": {
              "minItems": 1,
              "maxItems": 65536,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "color": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16,
                        "pattern": "^\\S+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "x",
                  "y",
                  "color"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "editorId",
            "projectGeneration",
            "layerId",
            "beads"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "pindouverse_draw_shape",
        "displayName": "Pindou: draw shape",
        "modelDescription": "Draw a line, rectangle or circle on a named layer using editor geometry. Coordinates are zero-based; null clears cells. Shapes outside canvas bounds are rejected, never clipped.",
        "toolReferenceName": "pindou_draw_shape",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "editorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "projectGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "layerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "color": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^\\S+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "shape": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "line"
                    },
                    "start": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "end": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "rectangle"
                    },
                    "region": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 256
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 256
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "additionalProperties": false
                    },
                    "filled": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "region"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "circle"
                    },
                    "center": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "radius": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "filled": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "center",
                    "radius"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "editorId",
            "projectGeneration",
            "layerId",
            "color",
            "shape"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "pindouverse_fill_region",
        "displayName": "Pindou: fill region",
        "modelDescription": "Fill a rectangle or a connected region on a named layer. Coordinates are zero-based; null erases. This is one reversible edit.",
        "toolReferenceName": "pindou_fill_region",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "editorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "projectGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "layerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "color": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^\\S+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "region": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "rectangle"
                    },
                    "bounds": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 256
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 256
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "bounds"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "connected"
                    },
                    "seed": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "seed"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "editorId",
            "projectGeneration",
            "layerId",
            "color",
            "region"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "pindouverse_replace_color",
        "displayName": "Pindou: replace color",
        "modelDescription": "Replace actual palette codes in an explicit layer/rectangle or all layers in one reversible operation. Hidden layers are not silently edited or skipped.",
        "toolReferenceName": "pindou_replace_color",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "editorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "projectGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "from": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^\\S+$"
            },
            "to": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^\\S+$"
            },
            "scope": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "layer"
                    },
                    "layerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "region": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 256
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 256
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "layerId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "allLayers"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "editorId",
            "projectGeneration",
            "from",
            "to",
            "scope"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "pindouverse_resize_canvas",
        "displayName": "Pindou: resize canvas",
        "modelDescription": "Resize canvas bounds without resampling using anchorRow/anchorCol 0,1,2. Data loss requires allowDataLoss=true and the expectedRevision returned by the loss estimate.",
        "toolReferenceName": "pindou_resize_canvas",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "editorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "projectGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "anchorRow": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "anchorCol": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "allowDataLoss": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "editorId",
            "projectGeneration",
            "width",
            "height",
            "anchorRow",
            "anchorCol"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "allowDataLoss"
                ],
                "properties": {
                  "allowDataLoss": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "expectedRevision"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "pindouverse_manage_layer",
        "displayName": "Pindou: manage layer",
        "modelDescription": "Add, rename, activate, show/hide, change opacity, reorder, duplicate, merge down or remove layers by ID. Removing nonempty layers requires allowDataLoss and the estimate's expectedRevision. Activation is nonpersistent.",
        "toolReferenceName": "pindou_manage_layer",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "editorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "projectGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "change": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "add"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "rename"
                    },
                    "layerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "kind",
                    "layerId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "activate"
                    },
                    "layerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "kind",
                    "layerId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "visibility"
                    },
                    "layerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "layerId",
                    "visible"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "opacity"
                    },
                    "layerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "kind",
                    "layerId",
                    "opacity"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "reorder"
                    },
                    "layerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "up",
                        "down"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "layerId",
                    "direction"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "duplicate"
                    },
                    "layerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "kind",
                    "layerId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "mergeDown"
                    },
                    "layerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "kind",
                    "layerId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "remove"
                    },
                    "layerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
