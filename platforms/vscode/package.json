  "scripts": {
    "sync:tools": "esbuild scripts/sync-agent-tools.ts --bundle --platform=node --format=cjs --outfile=dist/sync-agent-tools.cjs && node dist/sync-agent-tools.cjs",
    "check:tools": "esbuild scripts/sync-agent-tools.ts --bundle --platform=node --format=cjs --outfile=dist/sync-agent-tools.cjs && node dist/sync-agent-tools.cjs --check",
    "build": "npm run check:types && npm run build:ext && npm run build:webview",
    "check:types": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.webview.json",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build:webview": "vite build --config webview/vite.config.ts",
    "watch": "concurrently \"npm run watch:ext\" \"npm run watch:webview\"",
    "watch:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "watch:webview": "vite build --config webview/vite.config.ts --watch",
    "package": "vsce package",
    "publish:pat": "npm run build && npm run package && vsce publish",
    "publish:entra": "npm run build && npm run package && node scripts/publish-entra.js",
    "test": "npm run test:unit && npm run test:webview && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:webview": "npm run build && playwright test",
    "test:e2e": "npm run build && tsc -p tests-e2e/tsconfig.json && node out-e2e/runner.js"
  },
