    "@types/node": "^25.6.0",
    "@types/vscode": "1.99.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/test-electron": "^2.5.2",
    "concurrently": "^8.2.0",
    "esbuild": "^0.20.0",
    "mocha": "^11.7.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.4"
  },
