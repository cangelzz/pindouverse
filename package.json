{
  "name": "pindouverse",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "ext:dev": "vite --config platforms/extension/vite.config.ts",
    "ext:build": "node scripts/build-extension.mjs chrome",
    "ext:build:chrome": "node scripts/build-extension.mjs chrome",
    "ext:build:edge": "node scripts/build-extension.mjs edge",
    "ext:build:test": "node scripts/build-extension.mjs chrome test",
    "ext:validate": "tsc -p platforms/extension/tsconfig.json --noEmit && node scripts/validate-extension-manifest.mjs platforms/extension/dist/chrome && node scripts/validate-extension-manifest.mjs platforms/extension/dist/edge",
    "ext:package": "npm run ext:build:chrome && npm run ext:build:edge && node scripts/package-extension.mjs chrome edge",
    "ext:test:packaging": "node --test scripts/validate-extension-manifest.node-test.mjs",
    "ext:test:contract": "npm run ext:build:test && playwright test --config platforms/extension/playwright.config.ts contract.spec.ts",
    "ext:test:e2e": "npm run ext:build:test && playwright test --config platforms/extension/playwright.config.ts",
    "ext:assert:no-ai": "node scripts/assert-extension-no-ai.fixtures.mjs && node scripts/assert-extension-no-ai.mjs",
    "ext:screenshots:check": "node scripts/generate-store-screenshots.mjs --check",
    "ext:screenshots": "node scripts/generate-store-screenshots.mjs",
    "ext:screenshots:update": "node scripts/generate-store-screenshots.mjs --update",
    "ext:screenshots:update-ci-baseline": "node scripts/generate-store-screenshots.mjs --update-ci-baseline",
    "ext:screenshots:validate": "node scripts/store-screenshots.mjs",
    "ext:screenshots:test": "node --test scripts/store-screenshots.node-test.mjs",
    "test:screenshots": "npm run ext:screenshots:test && npm run ext:screenshots:validate",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "i18next": "^26.3.6",
    "image-size": "2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.11",
    "zod": "4.6.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/archiver": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "archiver": "^8.0.0",
    "fake-indexeddb": "^6.2.5",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.4",
    "yauzl": "^3.4.0"
  }
}
